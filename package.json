{
  "name": "agents-bridge",
  "version": "0.1.0",
  "description": "Connect agents to IM, to other agents, and to tools — one local process, one bridge.yaml.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agents-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node src/cli.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
